<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dictado del asistente. Se pide en caliente, la primera vez que se toca el microfono. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Mantiene la app en primer plano mientras el asistente espera al modelo, para que el
        sistema no cierre la conexion de red al bloquear la pantalla o salir de la app.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Sin este permiso la notificacion del servicio no se ve, pero el servicio sigue
         funcionando igual: Android permite mantener el primer plano aunque no se muestre nada. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- El actualizador: abre el instalador de Android con el APK nuevo que ha descargado.
         Android pide al usuario que lo permita la primera vez. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- El reconocedor de voz vive en otra app; sin esto no se puede consultar si existe. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <queries>
        <intent>
            <action android:name="android.settings.APP_LOCALE_SETTINGS" />
        </intent>

        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".app.infrastructure.android.FoodYouApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="${applicationIcon}"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="${applicationRoundIcon}"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodYou"
        tools:targetApi="36">

        <activity
            android:name=".app.infrastructure.android.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".app.infrastructure.android.ShareProductActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FoodYou"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <activity
            android:name=".app.infrastructure.android.CrashReportActivity"
            android:exported="false"
            android:label="CrashReportActivity"
            android:theme="@style/Theme.FoodYou" />

        <activity
            android:name=".app.infrastructure.android.DeveloperActivity"
            android:exported="false"
            android:label="DeveloperActivity"
            android:theme="@style/Theme.FoodYou" />

        <!--
            Deja que la camara escriba la foto del asistente en nuestra cache. Sin esto solo se
            podria adjuntar desde la galeria, que obliga a hacer la foto fuera de la app primero.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            No hace nada por si sola: solo mantiene el proceso en primer plano mientras dura una
            peticion al modelo, para que bloquear la pantalla no tumbe la conexion a mitad de una
            cadena de herramientas.
        -->
        <service
            android:name=".assistant.infrastructure.AssistantKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>